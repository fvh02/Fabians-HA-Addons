#!/usr/bin/env python3
"""Fabians-HA-Himmel: the sky above home, reached through Fabians-HA-Master. Prints JSON.

  himmel heute        what is to be seen tonight (ISS, meteors, eclipses, clouds, moon) with a ready text
  himmel uebersicht   everything: visible ISS passes (10 days), moon phases, clear nights, meteor showers, eclipses
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE = os.environ.get("HIMMEL_URL", "").rstrip("/")


def out(data) -> None:
    print(json.dumps(data, ensure_ascii=False, indent=1))


def fail(message: str) -> None:
    out({"error": message})
    sys.exit(1)


def call(method: str, path: str, body=None, raw: bytes | None = None, ctype: str = "application/json", timeout: int = 90):
    if not BASE:
        fail("Fabians-HA-Himmel ist nicht installiert.")
    data = raw if raw is not None else (json.dumps(body).encode() if body is not None else None)
    req = urllib.request.Request(BASE + path, data=data, method=method, headers={"Content-Type": ctype})
    try:
        # The add-ons are inside Home Assistant: never through a proxy.
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=timeout) as resp:
            return json.loads(resp.read() or b"null")
    except urllib.error.HTTPError as err:
        try:
            fail(json.loads(err.read()).get("error") or f"Fehler {err.code}")
        except ValueError:
            fail(f"Fehler {err.code}")
    except (urllib.error.URLError, OSError) as err:
        fail(f"Himmels-Kalender nicht erreichbar: {getattr(err, 'reason', err)}")


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    if argv[0] == "heute":
        out(call("GET", "/api/heute", timeout=120))
    elif argv[0] in ("uebersicht", "übersicht", "iss"):
        out(call("GET", "/api/uebersicht", timeout=120))
    else:
        fail("himmel heute|uebersicht")


if __name__ == "__main__":
    main(sys.argv[1:])
