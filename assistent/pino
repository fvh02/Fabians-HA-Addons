#!/usr/bin/env python3
"""Fabians-HA-Pino: the kiwi with a life of its own, reached through Fabians-HA-Master. Prints JSON.

  pino status            what Pino is doing and thinking right now, his needs, interests and latest experiences
  pino tagebuch [N]      his last diary entries (default 3)
  pino erlebnisse [N]    what he did lately (default 10)
  pino webseiten         the websites he built in his workshop
  pino bilder [N]        his latest paintings (default 5)
  pino wissen            what he learned on Wikipedia, YouTube and GitHub, by topic
"""

import json
import os
import sys
import urllib.error
import urllib.request

BASE = os.environ.get("PINO_URL", "").rstrip("/")


def out(data) -> None:
    print(json.dumps(data, ensure_ascii=False, indent=1))


def fail(message: str) -> None:
    out({"error": message})
    sys.exit(1)


def call(path: str, timeout: int = 30):
    if not BASE:
        fail("Fabians-HA-Pino ist nicht installiert.")
    req = urllib.request.Request(BASE + path, headers={"Accept": "application/json"})
    try:
        # The add-ons are inside Home Assistant: never through a proxy.
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=timeout) as resp:
            return json.loads(resp.read() or b"null")
    except urllib.error.HTTPError as err:
        try:
            fail(json.loads(err.read()).get("error") or f"Fehler {err.code}")
        except ValueError:
            fail(f"Fehler {err.code}")
    except (urllib.error.URLError, OSError) as err:
        fail(f"Pino nicht erreichbar: {getattr(err, 'reason', err)}")


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd = argv[0]
    n = int(argv[1]) if len(argv) > 1 and argv[1].isdigit() else None
    if cmd == "status":
        out(call("/api/pino/status"))
    elif cmd == "tagebuch":
        out(call(f"/api/pino/tagebuch?n={n or 3}"))
    elif cmd == "erlebnisse":
        out([f"{e['at'][:16].replace('T', ' ')}: {e['text']}" for e in call(f"/api/pino/erlebnisse?n={n or 10}")])
    elif cmd == "webseiten":
        out([{k: s.get(k) for k in ("title", "description", "topic", "updated", "changes")} for s in call("/api/pino/webseiten")])
    elif cmd == "bilder":
        out(call(f"/api/pino/bilder?n={n or 5}"))
    elif cmd == "wissen":
        out({topic: [f"{k['quelle']} „{k['titel']}“: {k['text']}" for k in items[:3]]
             for topic, items in call("/api/pino/wissen").items()})
    else:
        fail("Unbekannter Aufruf. Siehe: pino --help")


if __name__ == "__main__":
    main(sys.argv[1:])
