#!/usr/bin/env python3
"""Fabians-HA-Gedächtnis: the long-term memory, reached through Fabians-HA-Master. Prints JSON.

  gedaechtnis merken TEXT [--thema T] [--zeit ISO]   remember something (sorted in by the add-on within a minute)
  gedaechtnis kontext THEMA [--max N]               everything relevant about a topic, ready to use (default 4000 chars)
  gedaechtnis suche BEGRIFF                         matching notes with a short excerpt
  gedaechtnis notiz TITEL                           one note: facts with time and source, history, links
  gedaechtnis profil                                the short profile of the person
  gedaechtnis tagebuch [TAGE]                       the diary of the last days (default 3)
  gedaechtnis status                                state of the memory and its inbox
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE = os.environ.get("BRAIN_URL", "").rstrip("/")
KEY = os.environ.get("BRAIN_API_KEY", "")


def out(data) -> None:
    print(json.dumps(data, ensure_ascii=False, indent=1))


def call(method: str, path: str, body: dict | None = None, timeout: int = 30):
    if not BASE:
        out({"error": "Fabians-HA-Gedächtnis ist nicht installiert."})
        sys.exit(1)
    data = json.dumps(body or {}).encode() if method == "POST" else None
    headers = {"Content-Type": "application/json"}
    if KEY:
        headers["X-Brain-Key"] = KEY
    req = urllib.request.Request(BASE + path, data=data, method=method, headers=headers)
    try:
        # The memory is inside the add-on network: never through a proxy.
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=timeout) as resp:
            return json.loads(resp.read() or b"null")
    except urllib.error.HTTPError as err:
        try:
            return json.loads(err.read())
        except ValueError:
            out({"error": f"Fehler {err.code}"})
            sys.exit(1)
    except (urllib.error.URLError, OSError) as err:
        out({"error": f"Gedächtnis nicht erreichbar ({BASE}): {getattr(err, 'reason', err)}"})
        sys.exit(1)


def flag(args: list[str], name: str) -> str:
    """Remove --name VALUE from args and return VALUE ("" if missing)."""
    if name in args:
        i = args.index(name)
        value = args[i + 1] if i + 1 < len(args) else ""
        del args[i:i + 2]
        return value
    return ""


def q(text: str) -> str:
    return urllib.parse.quote(text)


def main(argv: list[str]) -> None:
    cmd = argv[0].lower() if argv else "--help"
    args = argv[1:]
    if cmd in ("-h", "--help"):
        print(__doc__.strip())
    elif cmd == "merken":
        subject, when = flag(args, "--thema"), flag(args, "--zeit")
        text = " ".join(args).strip()
        if not text:
            out({"error": "Was soll ich mir merken? gedaechtnis merken TEXT"})
            sys.exit(1)
        body = {"text": text, "source": "assistent", "subject": subject}
        if when:
            body["occurred_at"] = when
        out(call("POST", "/api/remember", body))
    elif cmd == "kontext":
        limit = flag(args, "--max") or "4000"
        out(call("GET", f"/api/context?q={q(' '.join(args))}&max_chars={q(limit)}"))
    elif cmd == "suche":
        out(call("GET", f"/api/search?limit=10&q={q(' '.join(args))}"))
    elif cmd == "notiz":
        out(call("GET", f"/api/note?title={q(' '.join(args))}"))
    elif cmd == "profil":
        out(call("GET", "/api/profile"))
    elif cmd == "tagebuch":
        days = args[0] if args and args[0].isdigit() else "3"
        out(call("GET", f"/api/events?days={days}"))
    elif cmd == "status":
        s = call("GET", "/api/status")
        out({k: s.get(k) for k in ("busy", "error", "inbox", "stats", "claude", "last_ingest", "last_consolidate")}
            if isinstance(s, dict) and "stats" in s else s)
    else:
        out({"error": "Unbekannter Aufruf. Siehe: gedaechtnis --help"})
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv[1:])
