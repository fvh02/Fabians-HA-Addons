#!/usr/bin/env python3
"""Fabians-HA-Serien: the series calendar, reached through Fabians-HA-Master. Prints JSON.

  serien liste                     followed series with next and last episode
  serien demnaechst [TAGE]         episodes of the next days (default 7), also the last 2 days
  serien suche NAME                find a series (TVmaze)
  serien folgen NAME|ID            add a series (the best match for NAME)
  serien entfolgen NAME|ID         remove a series
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

BASE = os.environ.get("SERIEN_URL", "").rstrip("/")


def out(data) -> None:
    print(json.dumps(data, ensure_ascii=False, indent=1))


def fail(message: str) -> None:
    out({"error": message})
    sys.exit(1)


def call(method: str, path: str, body=None, raw: bytes | None = None, ctype: str = "application/json", timeout: int = 90):
    if not BASE:
        fail("Fabians-HA-Serien ist nicht installiert.")
    data = raw if raw is not None else (json.dumps(body).encode() if body is not None else None)
    req = urllib.request.Request(BASE + path, data=data, method=method, headers={"Content-Type": ctype})
    try:
        # The add-ons are inside Home Assistant: never through a proxy.
        with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(req, timeout=timeout) as resp:
            return json.loads(resp.read() or b"null")
    except urllib.error.HTTPError as err:
        try:
            fail(json.loads(err.read()).get("error") or f"Fehler {err.code}")
        except ValueError:
            fail(f"Fehler {err.code}")
    except (urllib.error.URLError, OSError) as err:
        fail(f"Serien-Kalender nicht erreichbar: {getattr(err, 'reason', err)}")


def main(argv: list[str]) -> None:
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return
    cmd, rest = argv[0], " ".join(argv[1:]).strip()
    if cmd == "liste":
        out(call("GET", "/api/serien"))
    elif cmd == "demnaechst":
        days = int(rest) if rest.isdigit() else 7
        out(call("GET", f"/api/demnaechst?tage={days}"))
    elif cmd == "suche" and rest:
        out(call("GET", "/api/suche?" + urllib.parse.urlencode({"q": rest})))
    elif cmd == "folgen" and rest:
        out(call("POST", "/api/folgen", {"id": rest} if rest.isdigit() else {"name": rest}))
    elif cmd == "entfolgen" and rest:
        out(call("DELETE", "/api/folgen/" + urllib.parse.quote(rest)))
    else:
        fail("serien liste|demnaechst|suche|folgen|entfolgen")


if __name__ == "__main__":
    main(sys.argv[1:])
